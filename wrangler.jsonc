{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-24",
  "name": "gergo-miszori-dev",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "miszori.dev",
      "custom_domain": true,
    },
    // Legacy host: kept attached so a Cloudflare Redirect Rule can 301 it to miszori.dev
    {
      "pattern": "gergo.miszori.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
}
