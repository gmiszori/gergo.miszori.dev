---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Gergő Miszori',
  description = 'The website of Gergő Miszori.',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const site = Astro.site || 'https://miszori.dev';
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Gergő Miszori, Gergo Miszori, Miszori Gergő, Miszori Gergo, Personal Website, George Miszori"
    />
    <meta name="author" content="Gergő Miszori" />
    <meta
      name="robots"
      content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Gergő Miszori" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gergő Miszori" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Gergő Miszori" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline src="/theme-init.js"></script>
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "c6fc7ab63a634870adf37a819b1b4107"}'
    ></script><!-- End Cloudflare Web Analytics -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://miszori.dev/#website",
            "url": "https://miszori.dev",
            "name": "Gergő Miszori",
            "hasPart": [
              { "@id": "https://miszori.dev/#webpage" },
              { "@id": "https://miszori.dev/projects/#webpage" }
            ]
          },
          {
            "@type": "ProfilePage",
            "@id": "https://miszori.dev/#webpage",
            "url": "https://miszori.dev",
            "name": "Gergő Miszori",
            "isPartOf": { "@id": "https://miszori.dev/#website" },
            "mainEntity": {
              "@type": "Person",
              "@id": "https://miszori.dev/#person",
              "name": "Gergő Miszori",
              "jobTitle": "Computer Science Student",
              "url": "https://miszori.dev",
              "sameAs": [
                "https://github.com/gmiszori",
                "https://www.linkedin.com/in/gmiszori/",
                "https://www.instagram.com/gergomiszori/"
              ]
            }
          },
          {
            "@type": "CollectionPage",
            "@id": "https://miszori.dev/projects/#webpage",
            "url": "https://miszori.dev/projects",
            "name": "Projects & Notes — Gergő Miszori",
            "description": "Projects, research, and technical write-ups by Gergő Miszori.",
            "isPartOf": { "@id": "https://miszori.dev/#website" },
            "author": { "@id": "https://miszori.dev/#person" }
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="page-wrapper">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
</style>
