---
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <a href="/" class="brand">
    Gergő<span>Miszori</span>
    <span class="nav-badge">/projects</span>
  </a>
  <div class="nav-actions">
    <a href="/" class="home-link">← Main Site</a>
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .brand {
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand span {
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .home-link {
    padding: 7px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    transition: var(--transition);
  }

  .home-link:hover {
    border-color: var(--accent);
  }

  .nav-badge {
    font-size: 0.95rem;
    font-family: var(--font-mono);
    padding: 0.3rem 0.4rem;
    border-radius: 20px;
    background: var(--border);
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .brand {
      font-size: 1.15rem;
    }

    .nav-badge {
      display: none;
    }

    .nav-actions {
      gap: 8px;
    }
  }
</style>
