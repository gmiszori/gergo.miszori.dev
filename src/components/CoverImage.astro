---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  cover: ImageMetadata;
  coverLight?: ImageMetadata;
  width: number;
  class?: string;
}

const { cover, coverLight, width, class: className } = Astro.props;
---

{
  coverLight ? (
    <>
      <Image
        src={cover}
        alt=""
        width={width}
        class:list={[className, 'theme-dark-only']}
      />
      <Image
        src={coverLight}
        alt=""
        width={width}
        class:list={[className, 'theme-light-only']}
      />
    </>
  ) : (
    <Image src={cover} alt="" width={width} class={className} />
  )
}
