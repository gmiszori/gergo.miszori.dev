---
import { ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = ui[lang] || ui.en;
const currentYear = new Date().getFullYear();

const buildDate = new Date().toISOString().split('T')[0];
---

<footer>
  <div class="footer-socials">
    <a
      href="https://github.com/gmiszori"
      target="_blank"
      rel="noopener noreferrer"
      class="social-item"
      aria-label="GitHub Profile"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
        ></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span>GitHub</span>
    </a>

    <a
      href="https://signal.me/#eu/HSv2_cL6PZzka2oHj--SW_iQmnUy8vWbQDuniQJB9f3_HRf0iaNETZ0dBv08tNTA"
      target="_blank"
      rel="noopener noreferrer"
      class="social-item"
      aria-label="Signal Profile"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        ></path>
      </svg>
      <span>Signal</span>
    </a>

    <a
      href="https://www.linkedin.com/in/gmiszori/"
      target="_blank"
      rel="noopener noreferrer"
      class="social-item"
      aria-label="LinkedIn Profile"
    >
      <svg viewBox="0 0 24 24">
        <path
          d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
        ></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
  <p><span>{t.last_updated}</span>: {buildDate}</p>
  <p>© {currentYear} Gergő Miszori. <span>{t.footer_rights}</span></p>
</footer>
<style>
  footer {
    text-align: center;
    margin-top: auto;
    padding-top: 32px;
    padding-bottom: 32px;
    color: var(--text-sub);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 20px;
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: var(--transition);
    cursor: pointer;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }

  .social-item:hover {
    color: var(--accent);
    background: var(--surface);
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .social-item svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .footer-socials {
      gap: 16px;
    }
  }
</style>
