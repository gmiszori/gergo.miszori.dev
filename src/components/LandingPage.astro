---
import { Image } from 'astro:assets';
import gergooImg from '../assets/gergoo.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import ProjectSheet from './ProjectSheet.astro';
import { formatProjectDate } from '../utils/date';
import { getPublishedEntries } from '../utils/projects';

const entries = await getPublishedEntries();
const projects = entries
  .filter((p) => p.data.type === 'project')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const notes = entries.filter((p) => p.data.type === 'note');
const live = projects.filter((p) => p.data.status === 'Live').length;
---

<BaseLayout
  title="Gergő Miszori"
  description="The website of Gergő Miszori, a Computer Science student at ETH Zürich: projects, notes and contact."
>
  <div class="container">
    <SiteHeader />

    <section class="hero" aria-label="Introduction">
      <div class="hero-id">
        <Image
          src={gergooImg}
          alt="Gergő Miszori"
          width={336}
          height={336}
          quality="high"
          loading="eager"
          class="hero-photo"
        />
        <h1 class="hero-name">Gergő<br />Miszori</h1>
      </div>
      <p class="hero-lede">Computer Science at ETH Zürich.</p>
      <div class="hero-links">
        <a
          class="tlink"
          href="https://github.com/gmiszori"
          target="_blank"
          rel="me noopener noreferrer">GitHub ↗</a
        >
        <a
          class="tlink"
          href="https://www.linkedin.com/in/gmiszori/"
          target="_blank"
          rel="me noopener noreferrer">LinkedIn ↗</a
        >
        <a class="tlink" href="mailto:gergo@miszori.dev">gergo@miszori.dev</a>
      </div>
    </section>

    {
      projects.length > 0 && (
        <section id="projects" class="block" aria-labelledby="projects-heading">
          <div class="section-head">
            <h2 id="projects-heading" class="section-title">
              Projects
            </h2>
            {live > 0 && <span class="section-count">{live} live</span>}
          </div>
          <div class="sheets">
            {projects.map((p, i) => (
              <ProjectSheet entry={p} index={i} />
            ))}
          </div>
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section id="notes" class="block" aria-labelledby="notes-heading">
          <div class="section-head">
            <h2 id="notes-heading" class="section-title">
              Notes
            </h2>
            <span class="section-count">
              {notes.length} {notes.length === 1 ? 'note' : 'notes'}
            </span>
          </div>
          <ul class="notes">
            {notes.map((n) => (
              <li>
                <a class="note-row" href={`/notes/${n.id}/`}>
                  <span class="note-title">{n.data.title}</span>
                  {n.data.date && (
                    <time
                      class="note-date"
                      datetime={n.data.date.toISOString()}
                    >
                      {formatProjectDate(n.data.date)}
                    </time>
                  )}
                  {n.data.desc && <span class="note-desc">{n.data.desc}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="about" class="block about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="section-title">About</h2>
      <div>
        <p class="about-text">
          I study Computer Science at ETH Zürich. Before that I spent six years
          in the specialised mathematics programme at Radnóti Miklós High
          School.
        </p>
        <dl class="facts">
          <dt>matura</dt>
          <dd>Computer Science 100% (2025), Mathematics 98% (2026)</dd>
          <dt>languages</dt>
          <dd>Hungarian, English C1, German C1</dd>
          <dt>into</dt>
          <dd>Security, cryptography, web, AI</dd>
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    margin-bottom: 120px;
  }

  .hero-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
    margin-bottom: 32px;
  }

  .hero :global(.hero-photo) {
    width: var(--photo-size);
    height: var(--photo-size);
    border-radius: var(--radius-round);
    object-fit: cover;
  }

  .hero-name {
    font-size: clamp(3.6rem, 10vw, 8.2rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.84;
  }

  .hero-lede {
    margin-bottom: 20px;
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 34em;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 1.05rem;
  }

  /* Sections */
  .block {
    margin-bottom: 104px;
  }

  #projects {
    margin-bottom: 120px;
  }

  .sheets {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Notes */
  .notes {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .note-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .note-title {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note-row:hover .note-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .note-date {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-sub);
  }

  .note-desc {
    grid-column: 1 / -1;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 20px 48px;
    margin-bottom: 96px;
  }

  .about-text {
    margin-bottom: 28px;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 34em;
  }

  .facts {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 10px 20px;
  }

  .facts dt {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-sub);
  }

  @media (max-width: 760px) {
    .hero :global(.hero-photo) {
      width: 96px;
      height: 96px;
    }

    .hero-id {
      gap: 16px 20px;
    }

    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .facts {
      grid-template-columns: 96px minmax(0, 1fr);
    }
  }
</style>
