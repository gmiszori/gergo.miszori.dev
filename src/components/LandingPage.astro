---
import { Image } from 'astro:assets';
import gergooImg from '../assets/gergoo.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalePath, languages, ui } from '../i18n/ui';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';
import { formatProjectDate } from '../utils/date';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = ui[lang] || ui.en;

const [featured] = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.date ?? 0).getTime() -
      new Date(a.data.date ?? 0).getTime()
  );
---

<BaseLayout
  title="Gergő Miszori — Portfolio"
  description="The official personal website and portfolio of Gergő Miszori, a Computer Science student at ETH Zürich. Explore projects, engineering work, and contact info."
  lang={lang}
  localized
>
  <div class="glow-bg"></div>

  <div class="container">
    <header>
      <div class="nav-actions">
        <div class="lang-capsule">
          {
            (
              Object.entries(languages) as [keyof typeof languages, string][]
            ).map(([locale, label]) => (
              <a
                href={getLocalePath(locale)}
                class:list={['lang-btn', { active: lang === locale }]}
                aria-current={lang === locale ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>
        <ThemeToggle />
      </div>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1><span>{t.hero_title}</span></h1>
        <p>{t.hero_desc}</p>
        <div class="hero-links">
          <a href="/projects/" class="btn btn-primary">{t.cta_projects} →</a>
          <a
            href="https://github.com/gmiszori"
            target="_blank"
            rel="me noopener noreferrer"
            class="btn"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/gmiszori/"
            target="_blank"
            rel="me noopener noreferrer"
            class="btn"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <div class="hero-avatar">
        <div class="hero-avatar-inner">
          <Image
            src={gergooImg}
            alt="Gergő Miszori"
            width={480}
            height={480}
            quality="high"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="bento-grid">
      <div class="bento-card span-2">
        <h2>{t.bento_about_title}</h2>
        <p>{t.bento_about_text}</p>
      </div>

      <div class="bento-card">
        <h2>{t.bento_stats_title}</h2>
        <div class="metrics-container">
          <div class="metric-row">
            <div>
              <span class="metric-label">{t.stat_1_label}</span>
              <span class="metric-sub">{t.stat_1_sub}</span>
            </div>
            <span class="metric-value">100%</span>
          </div>
          <div class="metric-row">
            <div>
              <span class="metric-label">{t.stat_2_label}</span>
              <span class="metric-sub">{t.stat_2_sub}</span>
            </div>
            <span class="metric-value">98%</span>
          </div>
        </div>
      </div>

      {
        featured && (
          <a
            href={`/projects/${featured.id}/`}
            class="bento-card span-2 is-link featured"
          >
            <h2>{t.featured_title}</h2>
            {featured.data.date && (
              <time
                class="featured-date"
                datetime={featured.data.date.toISOString()}
              >
                {formatProjectDate(featured.data.date)}
              </time>
            )}
            <h3>{featured.data.title}</h3>
            <p>{featured.data.desc}</p>
            <span class="featured-more">{t.featured_more} →</span>
          </a>
        )
      }

      <div class="bento-card">
        <h2>{t.bento_lang_title}</h2>
        <div class="lang-row">
          <span class="lang-name">{t.lang_de_name}</span>
          <span class="lang-badge">Goethe C1</span>
        </div>
        <div class="lang-row">
          <span class="lang-name">{t.lang_en_name}</span>
          <span class="lang-badge">Cambridge C1</span>
        </div>
        <div class="lang-row">
          <span class="lang-name">{t.lang_hu_name}</span>
          <span class="lang-badge">{t.lang_hu_badge}</span>
        </div>
      </div>

      <div class="bento-card span-3">
        <h2>{t.bento_interests_title}</h2>
        <div class="interests-grid">
          <span class="interest-tag">{t.tag_1}</span>
          <span class="interest-tag">{t.tag_2}</span>
          <span class="interest-tag">{t.tag_3}</span>
          <span class="interest-tag">{t.tag_4}</span>
          <span class="interest-tag">{t.tag_5}</span>
          <span class="interest-tag">{t.tag_6}</span>
          <span class="interest-tag">{t.tag_7}</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Glow Background */
  .glow-bg {
    position: fixed;
    top: -10%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
    filter: blur(60px);
  }

  /* Header & Navigation */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    margin-left: auto;
    gap: 16px;
  }

  .lang-capsule {
    display: flex;
    background: var(--pill-bg);
    border: 1px solid var(--border);
    padding: 4px;
    border-radius: 999px;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 5px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 999px;
    transition: var(--transition);
  }

  .lang-btn.active {
    background: var(--text);
    color: var(--bg);
  }

  /* Hero Section */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: 72px;
    position: relative;
  }

  .hero-text {
    max-width: 680px;
    padding: 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .hero h1 :global(span) {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero p {
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: var(--text-muted);
    font-weight: 400;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--pill-bg);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    transition: var(--transition);
  }

  .btn:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--accent-gradient);
    border-color: transparent;
    color: #fff;
  }

  .btn-primary:hover {
    border-color: transparent;
    box-shadow: 0 10px 25px -10px var(--accent);
  }

  /* Avatar */
  .hero-avatar {
    width: 300px;
    height: 300px;
    flex-shrink: 0;
    border-radius: 50%;
    position: relative;
    padding: 5px;
    margin-right: 32px;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }

  .hero-avatar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent-gradient);
    z-index: 1;
  }

  .hero-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg);
    position: relative;
    z-index: 3;
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
    filter: grayscale(5%) contrast(102%);
  }

  .hero-avatar:hover {
    transform: scale(1.04) translateY(-2px);
  }

  .hero-avatar:hover img {
    transform: scale(1.05);
    filter: grayscale(0%) contrast(100%);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .bento-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 36px;
    box-shadow: var(--card-shadow);
    transition: var(--transition);
    backdrop-filter: blur(12px);
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .bento-card.is-link:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
    }
  }

  .bento-card.is-link:active {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.2);
  }

  .bento-card.span-2 {
    grid-column: span 2;
  }

  .bento-card.span-3 {
    grid-column: span 3;
  }

  /* Featured Project */
  .featured {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .featured h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 4px 0 8px;
  }

  .featured-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-sub);
  }

  .featured-more {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent);
  }

  .bento-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .bento-card p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Metrics */
  .metrics-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
  }

  .metric-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .metric-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .metric-value {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .metric-sub {
    font-size: 0.75rem;
    color: var(--text-sub);
    font-weight: 500;
    display: block;
  }

  /* Language List */
  .lang-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    margin-bottom: 14px;
    align-items: center;
  }

  .lang-row:last-child {
    margin-bottom: 0;
  }

  .lang-name {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .lang-badge {
    padding: 4px 10px;
    background: var(--pill-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent);
  }

  /* Interests */
  .interests-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .interest-tag {
    background: var(--pill-bg);
    border: 1px solid var(--border);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: var(--transition);
  }

  .interest-tag:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  /* Media Queries */
  @media (max-width: 900px) {
    header {
      margin-bottom: 32px;
      padding: 10px 14px;
      top: 12px;
    }

    .nav-actions {
      gap: 8px;
    }

    .lang-btn {
      padding: 4px 8px;
      font-size: 0.75rem;
    }

    .hero {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: 0px;
      margin-bottom: 0px;
    }

    .hero-text {
      align-items: center;
      text-align: center;
    }

    .hero-avatar {
      width: 250px;
      height: 250px;
      margin-right: 0px;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .bento-card.span-2,
    .bento-card.span-3 {
      grid-column: auto;
    }

    .hero-links {
      justify-content: center;
    }
  }
</style>
