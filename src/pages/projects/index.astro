---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverImage from '../../components/CoverImage.astro';
import ProjectsHeader from '../../components/ProjectsHeader.astro';
import { formatProjectDate } from '../../utils/date';
import { getPublishedEntries, hasWriteup } from '../../utils/projects';
import '/src/styles/project.css';

const entries = await getPublishedEntries();
const projects = entries
  .filter((p) => p.data.type === 'project')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const notes = entries.filter((p) => p.data.type === 'note');
---

<BaseLayout
  title="Projects & Notes — Gergő Miszori"
  description="Projects, research, and technical write-ups by Gergő Miszori."
>
  <div class="container">
    <ProjectsHeader />

    <div class="summary-view">
      <section class="hero">
        <h1>Projects & Notes</h1>
      </section>

      <section class="entry-section" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="section-title">Projects</h2>
        {
          projects.length > 0 ? (
            <div class="projects-grid">
              {projects.map((p) => {
                // Card opens the live project when there is one, otherwise the write-up
                const external = p.data.url;
                const href = external ?? `/projects/${p.id}/`;
                return (
                  <article class="project-card">
                    {p.data.cover && (
                      <CoverImage
                        cover={p.data.cover}
                        coverLight={p.data.coverLight}
                        width={720}
                        class="project-cover"
                      />
                    )}
                    <div>
                      {p.data.date && (
                        <div class="project-meta">
                          <time datetime={p.data.date.toISOString()}>
                            {formatProjectDate(p.data.date)}
                          </time>
                        </div>
                      )}
                      <div class="project-title-row">
                        <h3 class="project-title">
                          <a
                            href={href}
                            class="card-link"
                            {...(external && {
                              target: '_blank',
                              rel: 'noopener noreferrer',
                            })}
                          >
                            {p.data.title}
                          </a>
                        </h3>
                        {p.data.status && (
                          <span
                            class:list={[
                              'status',
                              `status-${p.data.status.toLowerCase().replace(' ', '-')}`,
                            ]}
                          >
                            {p.data.status}
                          </span>
                        )}
                      </div>
                      <p class="project-desc">{p.data.desc}</p>
                    </div>
                    {((external && hasWriteup(p)) || p.data.repo) && (
                      <div class="project-actions">
                        {external && hasWriteup(p) && (
                          <a href={`/projects/${p.id}/`} class="action">
                            Write-up
                          </a>
                        )}
                        {p.data.repo && (
                          <a
                            href={p.data.repo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="action"
                          >
                            Source ↗
                          </a>
                        )}
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          ) : (
            <p class="empty-state">Nothing to show yet, check back later!</p>
          )
        }
      </section>

      <section class="entry-section" aria-labelledby="notes-heading">
        <h2 id="notes-heading" class="section-title">Notes</h2>
        {
          notes.length > 0 ? (
            <ul class="notes-list">
              {notes.map((n) => (
                <li>
                  <a class="note-row" href={`/projects/${n.id}/`}>
                    <time
                      class="note-date"
                      datetime={n.data.date?.toISOString()}
                    >
                      {formatProjectDate(n.data.date)}
                    </time>
                    <span class="note-body">
                      <span class="note-title">{n.data.title}</span>
                      {n.data.desc && (
                        <span class="note-desc">{n.data.desc}</span>
                      )}
                    </span>
                    <span class="note-tags">
                      {n.data.tags.map((t) => (
                        <span class="tag">{t}</span>
                      ))}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty-state">Nothing to show yet, check back later!</p>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>
